<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/rl_choose_cloud_service"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<View
		android:id="@+id/choose_cloud_service_header_extension"
		android:layout_width="match_parent"
		android:layout_height="24dp"
		android:background="?attr/colorPrimary" />

	<View
		android:id="@+id/choose_cloud_service_header_spacing"
		android:layout_width="match_parent"
		android:layout_height="12dp"
		android:layout_below="@id/choose_cloud_service_header_extension" />

	<include
		android:id="@+id/rv_choose_cloud_service"
		layout="@layout/recycler_view_layout"
		android:layout_below="@id/choose_cloud_service_header_spacing" />

</RelativeLayout>
